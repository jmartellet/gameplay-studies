{
  "name": "pedirjogo",
  "version": "0.1.0",
  "description": "Fila de pedidos de jogos para streamers: busca na Steam, votação dos inscritos e bots de Twitch/Discord.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "discord:register": "tsx src/scripts/register-discord-commands.ts"
  },
  "keywords": [
    "steam",
    "twitch",
    "discord",
    "streaming",
    "bot",
    "voting"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "tmi.js": "^1.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/tmi.js": "^1.8.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
